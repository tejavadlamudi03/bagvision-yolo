# BagVision YOLO settings (no secrets in here - safe to share)

# camera: "realsense" (Intel RealSense D4xx), a webcam number (0, 1, ...) or a stream/video (rtsp://..., video.mp4)
CAMERA=realsense

# folders (relative to the project folder)
BAG_DATA_DIR=bag_data
BAG_MODEL_DIR=models
BAG_OUTPUT_DIR=inspections

# model
BASE_MODEL=yolo11s-cls.pt
IMGSZ=384
DEVICE=auto

# p(bad) needed to call a bag BAD (lower = stricter)
BAD_THRESHOLD=0.5
